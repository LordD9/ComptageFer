# Copier dans .env et remplir : cp .env.example .env
# .env n'est pas commité. Docker Compose lit ce fichier tout seul, depuis le
# répertoire où se trouve compose.yaml ; l'application ne l'ouvre jamais, elle
# ne voit que les variables que le compose lui a passées.
#
# Une ligne par variable, NOM=valeur, sans guillemets, sans espace autour du
# =. Le README détaille ce que Compose tolère et ce qu'il ignore en silence.

# Jeton qui ouvre /admin. Sans valeur, l'admin est fermé et rien ne s'y inscrit.
# Tirer au hasard, plutôt qu'à l'écrire à la main : openssl rand -hex 24
ADMIN_TOKEN=change-me

# Publication automatique du CSV sur data.gouv.fr, chaque nuit à minuit.
# Les deux lignes ci-dessous activent la fonctionnalité. La clé s'obtient
# sur https://www.data.gouv.fr/api/account/ ; le DATASET_ID est l'identifiant
# du jeu de données dans son URL.
DATAGOUV_API_KEY=
DATAGOUV_DATASET_ID=

# Optionnels.
# DATAGOUV_RESOURCE_ID= : ressource à remplacer chaque nuit. Laissée vide, la
# première publication crée la ressource et la retient.
# DATAGOUV_PUBLISH_HOUR=0 : heure de publication, heure de Paris.

# COMPTAGEFER_DATA n'est pas ici : c'est le point de montage du volume, il est
# écrit en dur dans compose.yaml pour que la variable et le chemin ne puissent
# pas diverger.
